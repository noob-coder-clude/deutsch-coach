<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="14dp"
            android:background="#1565C0" android:gravity="center_vertical">
            <ImageView android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_logo" android:layout_marginEnd="12dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Deutsch Coach" android:textSize="19sp" android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="#1565C0" />
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout android:id="@+id/welcome" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical"
        android:background="#1565C0" android:gravity="center" android:padding="30dp">
        <ImageView android:layout_width="104dp" android:layout_height="104dp"
            android:src="@drawable/ic_logo" android:layout_marginBottom="22dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Deutsch Coach" android:textSize="27sp" android:textStyle="bold"
            android:textColor="#FFFFFF" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="مربی مکالمه‌ای آلمانی به روش میشل توماس"
            android:textSize="13sp" android:textColor="#FFFFFF" android:layout_marginTop="8dp" />
        <Button android:id="@+id/start_btn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="شروع کنیم"
            android:layout_marginTop="30dp" android:backgroundTint="#FFFFFF"
            android:textColor="#0D47A1" />
    </LinearLayout>
</FrameLayout>
