<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <!-- Hero -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#1565C0"
        android:padding="18dp" android:layout_marginBottom="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/hero_hi" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="آماده‌ای رفیق؟"
                android:textSize="19sp" android:textStyle="bold" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/hero_date" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textColor="#FFFFFF" android:layout_marginTop="4dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="امروز فقط همین ۵ قدم. هرچی آروم‌تر بری، سریع‌تر یاد می‌گیری."
                android:textSize="12sp" android:textColor="#FFFFFF" android:layout_marginTop="8dp" />
        </LinearLayout>
        <!-- Ring -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_marginStart="8dp">
            <TextView android:id="@+id/ring_pct" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="۰/۵"
                android:textSize="16sp" android:textStyle="bold" android:textColor="#FFD54F" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="امروز" android:textSize="9sp" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pledge card -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#FFF8E6"
        android:padding="16dp" android:layout_marginBottom="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🛡 قانون طلایی: تقلب ممنوع" android:textSize="14.5sp"
            android:textStyle="bold" android:textColor="#E65100" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="هیچ‌وقت سراغ مترجم و دیکشنری نرو. اگه کلمه‌ای یادت نیست، همون‌جا بمون — مغزت خودش الگو رو می‌گیره."
            android:textSize="12.5sp" android:textColor="#7A5A16" android:layout_marginTop="6dp" />
        <Button android:id="@+id/pledge_btn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="امروز قول می‌دم تقلب نکنم"
            android:layout_marginTop="10dp" android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF" />
        <TextView android:id="@+id/stamp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="✓ قول امروز ثبت شد"
            android:textSize="11sp" android:textStyle="bold" android:textColor="#E65100"
            android:layout_marginTop="8dp" android:visibility="gone" />
    </LinearLayout>

    <!-- Checklist card -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#FFFFFF"
        android:padding="16dp" android:layout_marginBottom="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="✅ چک‌لیست امروز" android:textSize="14.5sp"
            android:textStyle="bold" android:textColor="#1565C0" />
        <ProgressBar android:id="@+id/ck_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="8dp" android:progressTint="#1565C0" />
        <LinearLayout android:id="@+id/ck_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <EditText android:id="@+id/ck_input" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="وظیفهٔ دلخواهت رو بنویس…" android:textSize="13sp" />
            <Button android:id="@+id/ck_add" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="+" android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lesson picker -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#FFFFFF" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📚 لکسیون امروز" android:textSize="14.5sp"
            android:textStyle="bold" android:textColor="#1565C0" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout android:id="@+id/lesson_picker" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
