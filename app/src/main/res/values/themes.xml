<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DeutschCoach" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/surface_hi</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/accent_red</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSecondaryContainer">@color/surface_hi</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="fontFamily">@font/vazir</item>
        <item name="android:fontFamily">@font/vazir</item>
        <item name="materialCardViewStyle">@style/DC.Card</item>
    </style>

    <style name="DC.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="DC.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="textColor">@color/on_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>

    <style name="DC.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_red</item>
        <item name="textColor">@color/accent_red</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="DC.Chip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="checkable">true</item>
        <item name="strokeColor">@color/outline</item>
        <item name="textColor">@color/text_dim</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:checked">false</item>
    </style>
    <style name="DC.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/surface_hi</item>
    </style>
</resources>
